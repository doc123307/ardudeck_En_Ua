node-linker=hoisted
# CI (esp. Intel mac runners) hits transient npm registry socket timeouts;
# pnpm's defaults (60s, 2 retries) give up too early and fail the build.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
# Scripts use POSIX syntax (e.g. "a; b"); run them through pnpm's shell emulator on Windows too.
shell-emulator=true
